{
  "name": "@bridge-applications/tg-auth",
  "version": "2.0.0-rc.1",
  "description": "Typed authentication and encrypted session tokens for Telegram Mini Apps.",
  "type": "module",
  "license": "ISC",
  "author": "Bridge Applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bridge-applications/tg-auth-public.git"
  },
  "homepage": "https://github.com/bridge-applications/tg-auth-public#readme",
  "bugs": {
    "url": "https://github.com/bridge-applications/tg-auth-public/issues"
  },
  "keywords": [
    "telegram",
    "mini-app",
    "init-data",
    "authentication",
    "typescript",
    "jwe",
    "ed25519"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:workers": "npm run build && node scripts/check-workers.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run test:package && npm run test:workers",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.6",
    "jose": "^6.0.10"
  },
  "peerDependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10",
    "zod": "^4.1.12"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.1",
      "sharp": "^0.35.4"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
